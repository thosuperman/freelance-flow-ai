# Production configuration for the Lightsail deployment.
# Copy to /opt/freelanceflow/.env.production ON THE SERVER (chmod 600). Never commit real values.
# Generate secrets with: openssl rand -hex 32   (hex keeps them URL-safe)

# ─── Deployment ──────────────────────────────────────────────
APP_ENV="production"                       # blocks PAYPAL_MODE=mock
APP_DOMAIN="freelanceflow.hayaix.tech"     # used by Caddy for the TLS certificate
APP_URL="https://freelanceflow.hayaix.tech" # auth base URL, portal links, trusted origin
# Set automatically by release.sh to the running image (freelanceflow-app:<tag>).
APP_IMAGE=""

# ─── Database (PostgreSQL container on the private Docker network) ─────
# compose.prod.yml builds DATABASE_URL from this; use hex so it needs no URL encoding.
POSTGRES_PASSWORD=""

# ─── Auth and encryption ─────────────────────────────────────
BETTER_AUTH_SECRET=""                      # openssl rand -hex 32
APP_ENCRYPTION_KEY=""                      # openssl rand -base64 32 (exactly 32 bytes)

# ─── AI (Claude) ─────────────────────────────────────────────
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5-5"
AI_TIMEOUT_MS="90000"
# Site-wide cap on live AI calls per 24 hours (protects the API budget during public judging).
AI_DAILY_LIMIT="400"

# ─── PayPal (Sandbox only for the hackathon) ─────────────────
PAYPAL_MODE="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# Webhook created for https://freelanceflow.hayaix.tech/api/webhooks/paypal (not the ngrok one).
PAYPAL_WEBHOOK_ID=""
# Orders client: "sdk" (APIMatic-generated PayPal Server SDK, default) or "rest".
PAYPAL_ORDERS_CLIENT=""

# ─── Demo mode ───────────────────────────────────────────────
DEMO_MODE_ENABLED="true"
DEMO_RATE_LIMIT_PER_HOUR="8"
CRON_SECRET=""                             # openssl rand -hex 32

# ─── Analytics (AG Studio) ───────────────────────────────────
# Optional AG Studio licence/trial key (hides the trial watermark).
AG_STUDIO_LICENSE_KEY=""
# Site-wide cap on AG Studio assistant turns per 24 h (default 800).
AI_STUDIO_DAILY_TURNS=""

# Optional: a PayPal *Sandbox* buyer (Personal) login shown to reviewers on /demo, the judge
# walkthrough and the payment page. Shown only when PAYPAL_MODE=sandbox. Never commit real values.
DEMO_PAYPAL_BUYER_EMAIL=""
DEMO_PAYPAL_BUYER_PASSWORD=""
