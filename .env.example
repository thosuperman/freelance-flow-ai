# ─── Database ────────────────────────────────────────────────
# Local: `docker compose up -d` starts Postgres on port 54329.
DATABASE_URL="postgresql://freelanceflow:freelanceflow@localhost:54329/freelanceflow"

# ─── App ─────────────────────────────────────────────────────
# Public base URL (used for auth callbacks and client portal links).
APP_URL="http://localhost:3000"
# 32+ random bytes, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=""
# 32 random bytes, base64. Encrypts stored portal tokens. `openssl rand -base64 32`
APP_ENCRYPTION_KEY=""

# ─── AI provider ─────────────────────────────────────────────
# "anthropic" (real Claude) or "simulated" (deterministic local fallback, clearly labelled in the UI).
# Default: anthropic when ANTHROPIC_API_KEY is set, otherwise simulated.
AI_PROVIDER=""
ANTHROPIC_API_KEY=""
# Optional overrides
AI_MODEL="claude-opus-5-5"
AI_TIMEOUT_MS="90000"

# ─── PayPal ──────────────────────────────────────────────────
# "sandbox" (PayPal Sandbox, api-m.sandbox.paypal.com), "live", or "mock"
# (in-process simulated PayPal for automated tests; never allowed when VERCEL_ENV=production).
PAYPAL_MODE="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# Webhook id from the PayPal developer dashboard (required to verify webhook signatures).
PAYPAL_WEBHOOK_ID=""
# Orders client: "sdk" (APIMatic-generated PayPal Server SDK, default) or "rest".
PAYPAL_ORDERS_CLIENT=""
# Same value as PAYPAL_CLIENT_ID; exposed to the browser for the PayPal JS SDK (it is public by design).
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""

# ─── Demo mode ───────────────────────────────────────────────
# Allow visitors to start an isolated, time-limited demo workspace from /demo.
DEMO_MODE_ENABLED="true"
# Max demo workspaces per IP per hour (default 8)
DEMO_RATE_LIMIT_PER_HOUR=""
# Secret for /api/cron/cleanup-demo (Vercel Cron sends it as a Bearer token)
CRON_SECRET=""

# ─── Analytics (AG Studio) ───────────────────────────────────
# Optional AG Studio licence/trial key (hides the trial watermark).
AG_STUDIO_LICENSE_KEY=""
# Site-wide cap on AG Studio assistant turns per 24 h (default 800).
AI_STUDIO_DAILY_TURNS=""
